# Copy to .env for local development. In production set these in
# Vercel -> Project -> Settings -> Environment Variables.

# Neon (or any Postgres). Use the pooled connection string with sslmode=require.
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require

# Shared passcode for residents (post it in the community group chat).
# Unset = the board is public. Changing it signs everyone out.
COMMUNITY_PASSCODE=

# Optional: Discord channel webhook for feedback notifications.
FEEDBACK_WEBHOOK_URL=
